  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7a2a48472b06db34f9555de289daef5d, type: 3}
  m_Name: Dialogue_Intro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - character: {fileID: 11400000, guid: c45edb083bee1f448ad451a899802e7d, type: 2}
    text: Agh me duermo una siesta y ya es el fin del mundo...
    indicator: 0
    textSpeed: 2
  - character: {fileID: 11400000, guid: c45edb083bee1f448ad451a899802e7d, type: 2}
    text: Bueno deberiamos armar un refugio che, a ver si por los alrededores hay
      algo de materiales para construir
    indicator: 0
    textSpeed: 2
  - character: {fileID: 11400000, guid: c45edb083bee1f448ad451a899802e7d, type: 2}
    text: No podemos quedarnos en la calle llena de zombies, verdad Chori?
    indicator: 0
    textSpeed: 2
  - character: {fileID: 11400000, guid: 9c8f412ae8be27e459562d9f9f606903, type: 2}
    text: guau! guau! *trae algo arrastrando*
    indicator: 0
    textSpeed: 2
  - character: {fileID: 11400000, guid: c45edb083bee1f448ad451a899802e7d, type: 2}
    text: Chori, encontraste madera! Con eso ya nos armamos algo para empezar, buen
      chico!
    indicator: 0
    textSpeed: 2
