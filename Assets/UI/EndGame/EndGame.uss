.end-game-screen {
    width: 100%;
    height: 100%;

    align-items: center;
    justify-content: center;
}

.end-game-background {
    position: absolute;

    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    background-color: rgb(20, 18, 24);
}

.end-game-content {
    width: 80%;
    max-width: 900px;

    align-items: center;
    justify-content: center;
}

.end-game-title {
    width: 100%;

    margin-bottom: 35px;

    color: rgb(220, 180, 130);

    font-size: 70px;
    -unity-font-style: bold;

    -unity-text-align: middle-center;
}

.end-game-description {
    width: 85%;
    margin-bottom: 55px;
    color: rgb(220, 215, 205);
    font-size: 50px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Seguinos */

.end-game-follow-label {
    width: 100%;
    margin-bottom: 30px;
    color: rgb(210, 105, 50);
    font-size: 35px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Contenedor de los dos perfiles */

.end-game-social-links {
    flex-direction: row;

    align-items: center;
    justify-content: center;

    margin-bottom: 40px;
}

/* Botones de los perfiles */

.end-game-social-button {
    width: 220px;
    height: 280px;

    margin-left: 20px;
    margin-right: 20px;

    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;

    background-color: rgb(29, 25, 32);

    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;

    border-top-color: rgb(166, 71, 31);
    border-right-color: rgb(166, 71, 31);
    border-bottom-color: rgb(166, 71, 31);
    border-left-color: rgb(166, 71, 31);

    -unity-text-align: middle-center;
}

.end-game-social-button:hover {
    background-color: rgb(55, 35, 30);

    border-top-color: rgb(230, 125, 65);
    border-right-color: rgb(230, 125, 65);
    border-bottom-color: rgb(230, 125, 65);
    border-left-color: rgb(230, 125, 65);
}

.end-game-social-button:active {
    background-color: rgb(75, 40, 30);
}

.end-game-social-image {
    width: 180px;
    height: 180px;

    margin-bottom: 12px;

    -unity-background-scale-mode: scale-to-fit;
}

.end-game-social-name {
    width: 100%;

    color: rgb(255, 235, 215);

    font-size: 24px;
    -unity-font-style: bold;

    -unity-text-align: middle-center;
}

/* Volver al menú */

.end-game-button {
    min-width: 280px;
    min-height: 70px;

    padding-top: 12px;
    padding-right: 30px;
    padding-bottom: 12px;
    padding-left: 30px;

    margin-bottom: 35px;

    background-color: rgb(55, 48, 43);

    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;

    border-top-color: rgb(140, 100, 70);
    border-right-color: rgb(140, 100, 70);
    border-bottom-color: rgb(140, 100, 70);
    border-left-color: rgb(140, 100, 70);

    color: rgb(255, 235, 215);

    font-size: 25px;
    -unity-font-style: bold;

    -unity-text-align: middle-center;
}

.end-game-button:hover {
    background-color: rgb(75, 63, 54);

    border-top-color: rgb(140, 115, 95);
    border-right-color: rgb(140, 115, 95);
    border-bottom-color: rgb(140, 115, 95);
    border-left-color: rgb(140, 115, 95);
}

.end-game-button:active {
    background-color: rgb(40, 35, 32);
}