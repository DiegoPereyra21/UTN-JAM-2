
#LevelHUD {
    position: absolute;

    left: 0;
    right: 0;
    top: 0;

    width: 100%;
    height: 100%;

    padding-left: 30px;
    padding-right: 30px;
    padding-top: 25px;
}

#ItemsContainer {
    position: relative;

    width: 100%;
    height: 100px;

    top: 30px;

    flex-direction: row;
    align-items: center;
}

#HealthContainer {
    position: absolute;

    left: 0;
    top: 0;

    width: 210px;
    height: 70px;

    flex-direction: row;
    align-items: center;
    justify-content: flex-start;

    flex-shrink: 0;
}

.heart {
    width: 60px;
    height: 60px;

    margin: 0;
    padding: 0;

    flex-shrink: 0;

    background-repeat: no-repeat;
    background-position: center;

    -unity-background-scale-mode: scale-to-fit;
}

#Heart_01,
#Heart_02 {
    margin-right: 2px;
}

.heart-full {
    background-image: resource("Hearts/heart_full");
}

.heart-half {
    background-image: resource("Hearts/heart_half");
}

.heart-empty {
    background-image: resource("Hearts/heart_empty");
}

#TitleContainer {
    position: absolute;

    left: 50%;
    top: 0;

    width: 300px;
    height: 70px;

    translate: -50% 0;

    align-items: center;
    justify-content: center;

    flex-shrink: 0;
}

#TitleLabel {
    font-size: 32px;

    -unity-text-align: middle-center;

    white-space: nowrap;
}

#ResourcesContainer {
    position: absolute;

    right: 0;
    top: 0;

    width: 320px;
    height: 80px;

    flex-direction: row;

    align-items: center;
    justify-content: flex-end;

    flex-shrink: 0;
}

#Resource_01,
#Resource_02,
#Resource_03,
#Resource_04 {
    flex-direction: column;

    align-items: center;
    justify-content: center;

    width: 70px;
    height: 90px;

    margin-left: 8px;

    flex-shrink: 0;
}

#Resource_01 #Icon,
#Resource_02 #Icon,
#Resource_03 #Icon,
#Resource_04 #Icon {
    width: 64px;
    height: 64px;

    flex-shrink: 0;

    background-repeat: no-repeat;
    background-position: center;

    -unity-background-scale-mode: scale-to-fit;
}

#Resource_01 #Amount,
#Resource_02 #Amount,
#Resource_03 #Amount,
#Resource_04 #Amount {
    width: 70px;
    height: 24px;

    margin-top: 2px;

    flex-shrink: 0;

    font-size: 20px;

    -unity-text-align: middle-center;

    white-space: nowrap;
}